# Секреты Edge Function. Они задаются командой `supabase secrets set` и живут только в Supabase.
# В браузер и в этот репозиторий настоящие значения попадать не должны.

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# Цепочка моделей: если первая недоступна, берётся следующая (необязательно)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Адрес вашего сайта для CORS, например https://nxtcore.vercel.app (необязательно, по умолчанию любой)
ALLOWED_ORIGIN=https://your-site.vercel.app

# true пропускает фото, когда проверка ИИ недоступна. Для боевого режима оставьте false.
MODERATION_FAIL_OPEN=false
